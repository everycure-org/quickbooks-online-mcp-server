QUICKBOOKS_CLIENT_ID=your_client_id_here
QUICKBOOKS_CLIENT_SECRET=your_client_secret_here
QUICKBOOKS_REFRESH_TOKEN=your_refresh_token_here
QUICKBOOKS_REALM_ID=your_company_id_here
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/callback
QBO_ENVIRONMENT=sandbox
# Write tools are dry runs unless this is true
QBO_WRITE_ENABLED=false
# Required as well for sales receipt create/void when QBO_ENVIRONMENT=production
QBO_PRODUCTION_WRITES_CONFIRMED=false
# Item IDs allowed on a negative sales receipt line (fees item), comma separated
QBO_ALLOWED_NEGATIVE_ITEM_IDS=
